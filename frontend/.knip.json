{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.jsx!",
    "src/workers/ai.worker.js!",
    "src/world/terrain.worker.js!",
    "tests/**/*.{test,spec}.{js,jsx}",
    "scripts/**/*.{js,mjs}"
  ],
  "project": [
    "src/**/*.{js,jsx}!",
    "!src/**/*.test.{js,jsx}!",
    "tests/_support/**/*.js",
    "!src/brand.js!",
    "!src/i18n/keyReachability.js!",
    "!src/theme/contrast.js!",
    "!src/world/detile.js!",
    "!src/game/lights.js!",
    "!src/night/siegeDirector.js!"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "pgrep",
    "pkill",
    "ffmpeg",
    "ffprobe",
    "ioreg",
    "magick"
  ]
}
