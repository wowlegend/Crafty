#!/bin/sh
# Crafty pre-push gate: the checks that need the COMMIT RANGE being pushed, or that must run before the push
# publishes anything.
#
# WHAT RUNS, per pushed ref: mutation-proof-trailer over the commits the push introduces, then
# `ci/pipeline.sh --tier=push` (opsec-scan, queue-ledger, artifact-currency, registry-append-only) on the pushed
# commit. The range arrives on this hook's stdin and exists nowhere else, so no CI runner can run these the same way;
# opsec-scan is here because CI sees the content only once it is public.
#
# WHAT DOES NOT RUN: the static gates, the unit suite, build and bundle budget. CI runs them on the exact sha, and
# main's branch protection requires that sha's `ci ok`, so running them here only repeated them, in a fresh worktree
# with a full build, on an SSD writing four times its daily budget (DECISIONS 2026-10-28 item 24). The cost: no local
# result before CI. `bash ci/pipeline.sh --tier=certify` gives one by hand. e2e never ran here, and the eye-level lookbook
# (`node scripts/visual/lookbook.mjs`) is read by a person, not a hook.
#
# THE PUSHED COMMIT, NOT THE WORKING TREE. The range gates read files, so they must read the pushed commit's: a dirty
# working tree can hold the fix a pushed commit lacks. When the pushed commit is this checkout's HEAD and `git status`
# lists nothing, the checkout IS that commit's tree and the gates run in place; otherwise the commit is checked out
# into a detached worktree first, and removed after.
#
# Escape hatch: `git push --no-verify`.
# ⚠️ Using --no-verify to dodge a red gate is a reward-hack (CLAUDE.md, Invariants: never weaken to pass). If a gate is genuinely
# wrong, FIX THE GATE in its own commit with a written justification. Do not route around it.

set -e

# Hooks run with GIT_DIR (and friends) pointing at the invoking repo; `git worktree add` misbehaves if it
# inherits them. Clear them so the worktree commands resolve normally.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

REPO_ROOT=$(git rev-parse --show-toplevel)
ZERO="0000000000000000000000000000000000000000"

# git feeds pre-push one line per ref: <local_ref> <local_sha> <remote_ref> <remote_sha>
TARGETS=""
RANGES=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion: nothing to check
  [ -z "$local_sha" ] && continue
  TARGETS="$TARGETS $local_sha"
  # The commits actually being introduced. A brand-new branch sends the zero-sha as the remote side, in
  # which case there is no meaningful range and the trailer check simply skips rather than scanning history.
  if [ "$_remote_sha" != "$ZERO" ] && [ -n "$_remote_sha" ]; then
    RANGES="$RANGES $_remote_sha..$local_sha"
  fi
done

if [ -z "$TARGETS" ]; then
  printf '\n✓ pre-push: nothing to check (deletion, or no refs on stdin)\n\n'
  exit 0
fi
# The pushed ranges, for registry-append-only, which picks the one whose head is the sha it runs at. A new branch has no
# range here, and the script measures from its merge-base with origin/main instead. EXPORTED, or the node processes the
# pipeline starts never see it. Pinned by the PRODUCER cases in tests/scripts/artifact-currency-scope.test.js.
export PUSH_RANGES="$RANGES"

# Node 24.2+ first: below it every gate's import.meta.main guard is undefined and each gate would pass unrun.
node "$REPO_ROOT/frontend/scripts/ci/node-floor.mjs" || exit 1

# ── mutation-proof trailer ──────────────────────────────────────────────────────
# Cheap, and it runs FIRST: a commit that adds a gate without saying how it was proven to fail is rejected in
# milliseconds. The mutation-proof rule in CLAUDE.md has an enforcer.
for RANGE in $RANGES; do
  node "$REPO_ROOT/frontend/scripts/ci/mutation-proof-trailer.mjs" "$RANGE" || exit 1
done

# ── the push tier, on each pushed commit ────────────────────────────────────────
HEAD_SHA=$(git rev-parse --verify --quiet HEAD || true)
for SHA in $TARGETS; do
  SHORT=$(git rev-parse --short "$SHA")
  # --no-optional-locks: a status run here must not rewrite the index. A status that fails reads as dirty.
  DIRTY=$(git --no-optional-locks status --porcelain) || DIRTY="(git status failed)"

  if [ "$SHA" = "$HEAD_SHA" ] && [ -z "$DIRTY" ]; then
    printf '\n══ pre-push: %s is this checkout'"'"'s HEAD, with nothing modified or untracked: the push tier runs in place ══\n' "$SHORT"
    cd "$REPO_ROOT/frontend"
    # A failing pipeline REFUSES the push through `set -e`, so nothing may swallow this call's exit status: pinned by the
    # refusal cases in tests/scripts/prepush-range-gates.test.js and artifact-currency-scope.test.js.
    bash "$REPO_ROOT/ci/pipeline.sh" --tier=push
    cd "$REPO_ROOT"
  else
    printf '\n══ pre-push: %s is not this clean checkout'"'"'s HEAD: checking out the PUSHED COMMIT into a detached worktree ══\n' "$SHORT"
    WT="$(mktemp -d "${TMPDIR:-/tmp}/crafty-prepush-XXXXXX")"
    # Always tear the worktree down, on success, failure or interrupt.
    trap 'cd "$REPO_ROOT" 2>/dev/null; git worktree remove --force "$WT" >/dev/null 2>&1 || rm -rf "$WT"' EXIT INT TERM
    git worktree add --detach --quiet "$WT" "$SHA"
    # A pushed commit older than DECISIONS 2026-10-28 item 24 runs its own pipeline, whose push tier still has the
    # offline core and needs dependencies. A link costs nothing; the current push tier imports none.
    if [ -d "$REPO_ROOT/frontend/node_modules" ]; then ln -s "$REPO_ROOT/frontend/node_modules" "$WT/frontend/node_modules"; fi
    cd "$WT/frontend"
    bash "$WT/ci/pipeline.sh" --tier=push
    cd "$REPO_ROOT"
    git worktree remove --force "$WT" >/dev/null 2>&1 || rm -rf "$WT"
    trap - EXIT INT TERM
  fi

  printf '\n✓ pre-push: %s passed the push tier\n' "$SHORT"
done

printf '\n✓ pre-push: every pushed commit passed — pushing\n\n'
