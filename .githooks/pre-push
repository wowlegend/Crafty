#!/bin/sh
# Crafty pre-push gate.
#
# WHY: Vercel auto-deploys EVERY push to `main`. Until 2026-07-13 there was no CI and no hook, so a red
# push shipped straight to the live demo and nothing stopped it. CI (.github/workflows/ci.yml) is the
# backstop; this hook is the fast local one, so you find out in 40s instead of after the deploy.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────────────
# REWRITTEN 2026-08-02 — it now certifies THE COMMITS BEING PUSHED, not the working tree.
#
# The original ran `cd frontend && npm run lint / test:unit / build` against whatever happened to be on
# disk. Git tells a pre-push hook what is actually being pushed, on STDIN, and the old hook never read it.
# So a dirty working tree could certify a broken commit: the gates saw the fixed files while the pushed
# commit still contained the break.
#
# That is not hypothetical. On 2026-07-21 commit a72bffd removed an import that `input-abstraction-gates`
# requires. It pushed GREEN, because the fix was already sitting uncommitted in the tree; the break landed
# on main and was cleaned up afterwards in b443141. The hook reported success on a commit it never tested.
#
# Fix: check the pushed sha out into a detached worktree and run the gates THERE. node_modules is symlinked
# from the main checkout when the lockfile is identical (the common case, and what makes this ~40s instead
# of minutes); when the push changes the lockfile, the worktree installs its own so the gates run against
# the dependency set the push actually declares.
#
# SECOND HOLE, also closed: the old hook skipped lint, tests, build and the bundle budget entirely for any
# push touching no `frontend/` path. The whole gate set runs in well under a minute, so the "optimisation"
# bought nothing and left a docs-only push able to move a symlinked CLAUDE.md, a workflow file, or a hook
# with zero verification. There is no skip path any more.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────
#
# Runs the FAST, deterministic gates only. Deliberately NOT here:
#   * the 31-state visual gate (renders the real scene under swiftshader; load-sensitive, would flake)
#   * e2e (browser boot ~60s)
# Run those before a milestone: `npm run test:visual` / `npm run test:e2e`.
#
# Escape hatch: `git push --no-verify`.
# ⚠️ Using --no-verify to dodge a red gate is a reward-hack (LOOP-CHARTER §3). If a gate is genuinely
# wrong, FIX THE GATE in its own commit with a written justification. Do not route around it.

set -e

# Hooks run with GIT_DIR (and friends) pointing at the invoking repo; `git worktree add` misbehaves if it
# inherits them. Clear them so the worktree commands resolve normally.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

REPO_ROOT=$(git rev-parse --show-toplevel)
APP="$REPO_ROOT/frontend"
ZERO="0000000000000000000000000000000000000000"

# git feeds pre-push one line per ref: <local_ref> <local_sha> <remote_ref> <remote_sha>
TARGETS=""
RANGES=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion: nothing to certify
  [ -z "$local_sha" ] && continue
  TARGETS="$TARGETS $local_sha"
  # The commits actually being introduced. A brand-new branch sends the zero-sha as the remote side, in
  # which case there is no meaningful range and the trailer check simply skips rather than scanning history.
  if [ "$_remote_sha" != "$ZERO" ] && [ -n "$_remote_sha" ]; then
    RANGES="$RANGES $_remote_sha..$local_sha"
  fi
done

if [ -z "$TARGETS" ]; then
  printf '\n✓ pre-push: nothing to certify (deletion, or no refs on stdin)\n\n'
  exit 0
fi

# ── mutation-proof trailer ──────────────────────────────────────────────────────
# Cheap, and it runs FIRST: a commit that adds a gate without saying how it was proven to fail should be
# rejected in milliseconds, not after a full worktree build. LOOP-CHARTER §3's rule finally has an enforcer.
for RANGE in $RANGES; do
  node "$REPO_ROOT/frontend/scripts/ci/mutation-proof-trailer.mjs" "$RANGE" || exit 1
done

# ── baseline trailer ────────────────────────────────────────────────────────────
# Same shape, same position, for the ORACLE. The visual gate judges every frame against the committed
# PNGs, so those PNGs ARE the specification — and until 2026-08-09 not one of the ten gates looked at
# them. Measured: 79 of 1,603 commits rewrite baselines and 10 of the last 12 bundled a src/ change into
# the same commit, which makes an intended look change indistinguishable from a regression the oracle was
# updated to match.
for RANGE in $RANGES; do
  node "$REPO_ROOT/frontend/scripts/ci/baseline-trailer.mjs" "$RANGE" || exit 1
done

# ── green-tree receipt (AB's shape, adopted 2026-09-22 on Kevin's direction) ────────────────────────
#
# pre-commit certifies the offline core against the staged tree and records the INDEX TREE HASH. git's
# index tree IS the tree the resulting commit stores — verified, not assumed: `git write-tree` and
# `git rev-parse HEAD^{tree}` returned the same sha on a clean index. So when the tree being pushed is
# already in the receipt, spinning up a worktree to re-derive that answer buys nothing.
#
# WHAT THE RECEIPT DOES NOT AUTHORISE, and this is the part that makes it safe: it speaks only for the
# OFFLINE CORE. The commit-shaped gates read a COMMIT RANGE that did not exist when the receipt was
# written, so they run on EVERY push: the two trailers above, and queue-ledger / artifact-currency /
# e2e-freshness via `pipeline.sh --tier=push --range-only` below.
#
# THAT LAST PART WAS FALSE UNTIL 2026-09-22. A receipt match used to `continue` straight past the
# pipeline, and those three gates live in its push tier, so on every receipt-matched push they silently
# never ran — while this comment said they "run unconditionally, above". Only the trailers were above.
# Found when a partial-stage fix stopped the receipt being written, the full path ran for once, and
# artifact-currency surfaced 74 commits of drift that had accumulated past a gate nobody was running.
#
# The receipt lives in .git/ and so cannot survive a clone — a fresh checkout has certified nothing, which
# is the correct default. A missing or stale receipt costs a full certification: it fails toward WORK, not
# toward trust.
RECEIPT="$(git rev-parse --git-common-dir)/crafty-pipeline-green-tree"
GREEN_TREE=""
GREEN_TIER=""
GREEN_AT=""
if [ -f "$RECEIPT" ]; then
  GREEN_TREE=$(cut -d' ' -f1 "$RECEIPT" 2>/dev/null || true)
  GREEN_TIER=$(cut -d' ' -f2 "$RECEIPT" 2>/dev/null || true)
  GREEN_AT=$(cut -d' ' -f3 "$RECEIPT" 2>/dev/null || true)
fi

for SHA in $TARGETS; do
  SHORT=$(git rev-parse --short "$SHA")
  PUSHED_TREE=$(git rev-parse "$SHA^{tree}" 2>/dev/null || true)

  RANGE_FLAG=""
  if [ -n "$GREEN_TREE" ] && [ "$GREEN_TIER" = "commit" ] && [ -n "$PUSHED_TREE" ] && [ "$PUSHED_TREE" = "$GREEN_TREE" ]; then
    printf '\n══ pre-push: %s — offline core already certified on this exact tree (%s) ══\n' "$SHORT" "$GREEN_AT"
    printf '  tree %s matches the pre-commit receipt; the core is skipped, the commit-range gates still run.\n' "$(printf '%.10s' "$PUSHED_TREE")"
    RANGE_FLAG="--range-only"
  elif [ -n "$GREEN_TREE" ]; then
    printf '\n  (receipt present but for tree %s, not %s — certifying in full)\n' \
      "$(printf '%.10s' "$GREEN_TREE")" "$(printf '%.10s' "${PUSHED_TREE:-unknown}")"
  else
    printf '\n  (no green receipt on this machine — certifying in full)\n'
  fi
  if [ -z "$RANGE_FLAG" ]; then
    printf '\n══ pre-push: certifying the PUSHED COMMIT %s (not the working tree) ══\n' "$SHORT"
  fi

  WT="$(mktemp -d "${TMPDIR:-/tmp}/crafty-prepush-XXXXXX")"
  # Always tear the worktree down, on success, failure or interrupt.
  trap 'cd "$REPO_ROOT" 2>/dev/null; git worktree remove --force "$WT" >/dev/null 2>&1 || rm -rf "$WT"' EXIT INT TERM

  git worktree add --detach --quiet "$WT" "$SHA"

  # node_modules: symlink when the pushed lockfile matches the installed one, else install in-worktree.
  LOCK_TMP="$WT/.pushed-lock.json"
  git show "$SHA:frontend/package-lock.json" > "$LOCK_TMP" 2>/dev/null || : > "$LOCK_TMP"
  if [ -d "$APP/node_modules" ] && cmp -s "$LOCK_TMP" "$APP/package-lock.json"; then
    ln -s "$APP/node_modules" "$WT/frontend/node_modules"
  else
    printf '  … lockfile differs from the installed tree — installing inside the worktree\n'
    (cd "$WT/frontend" && npm install --no-audit --no-fund --silent)
  fi
  rm -f "$LOCK_TMP"

  cd "$WT/frontend"

  # THE PIPELINE, not a copy of it. This block used to restate 13 gates while .github/workflows/ci.yml
  # restated a DIFFERENT set; they disagreed, and the drift surfaced as CI mailing about a commit that
  # passed locally (2026-09-22: a damage-model change broke an E2E spec only the workflow ran).
  # ci/pipeline.sh is now the definition and both callers invoke it, so neither can drift.
  # shellcheck disable=SC2086 -- RANGE_FLAG is empty or one word, by construction above
  bash "$WT/ci/pipeline.sh" --tier=push $RANGE_FLAG

  cd "$REPO_ROOT"
  git worktree remove --force "$WT" >/dev/null 2>&1 || rm -rf "$WT"
  trap - EXIT INT TERM

  printf '\n✓ pre-push: %s certified green\n' "$SHORT"
done

printf '\n✓ pre-push: all pushed commits certified — pushing\n\n'
