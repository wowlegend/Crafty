# dependencies — no trailing slash: a lane links frontend/node_modules to the main checkout's, and `node_modules/`
# matches only a directory, never that symlink.
node_modules

# build output
build/
dist/

# env files
*.env
*.env.*
!*.env.example

# system files
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/

# misc
/coverage
*.tsbuildinfo

# brainstorming visual-companion sessions
.superpowers/

# Serena LSP index cache + project config (local tooling)
.serena/
graphify-out/
.graphify_*

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# AB-ATTRIBUTION-GUARD BEGIN — machine-local hook plumbing installed by
# Agentic-Brain/hooks/install-attribution-guard.sh; symlinks carry absolute paths.
/.githooks/pre-commit.local
/.githooks/post-commit.local
/.githooks/commit-msg
/.githooks/post-commit
# AB-ATTRIBUTION-GUARD END

# Agent harness, machine-local: what lanes and the operator's tooling create at the root. Worktree checkouts,
# graft's helper and skill copies, per-machine settings (also covered by a machine-global ignore, which a fresh
# clone does not have), the MCP server list and the search-tool ignore file.
/.claude/worktrees/
/.claude/helpers/
/.claude/skills/graft/
/.claude/settings.local.json
/.mcp.json
/.ignore
