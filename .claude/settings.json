{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(cmux close-surface)",
      "Bash(cmux close-surface *)"
    ],
    "ask": [
      "Bash(*close-preview-tabs.sh --close*)",
      "Bash(sh frontend/scripts/dev/close-preview-tabs.sh --close*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-start-compact.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
